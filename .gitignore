!data/processed/.gitkeep
*.csv
*.xlsx
*.zip

# Jupyter
.ipynb_checkpoints/
*/.ipynb_checkpoints/*

# Python
__pycache__/
*.py[cod]
*$py.class
.Python
env/
venv/
.venv/
*.egg-info/
.pytest_cache/

# Results that are regenerated
results/figures/*.png
results/tables/*.csv

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/

# Secrets
.env
*.key
